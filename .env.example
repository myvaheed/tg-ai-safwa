SAFWA_TELEGRAM_BOT_TOKEN=
# Bot username without @; used to build t.me deep links for all supported item citations.
SAFWA_TELEGRAM_BOT_USERNAME=
SAFWA_TELEGRAM_OWNER_ID=
SAFWA_TELEGRAM_OWNER_NAME=Name Surname
# Telethon application credentials for reading canonical Telegram dialogue history.
# Create them at my.telegram.org, then authorize once with: uv run safwa-auth
SAFWA_TELEGRAM_API_ID=
SAFWA_TELEGRAM_API_HASH=
SAFWA_TELEGRAM_HISTORY_REQUIRED=true
SAFWA_TELEGRAM_USER_SESSION_PATH=data/telegram-user
SAFWA_DATABASE_URL=sqlite:///data/safwa.db
SAFWA_DATA_DIR=data
# lmstudio (default) or openrouter. The selected provider supplies the base URL, retry
# budget, whether temperature is sent, and whether cache breakpoints are marked; every
# SAFWA_AI_* value below overrides that default when set.
SAFWA_AI_PROVIDER=lmstudio
SAFWA_AI_BASE_URL=http://localhost:1234/v1
SAFWA_AI_API_KEY=lm-studio
SAFWA_AI_MODEL=local-model
SAFWA_AI_TIMEOUT_SECONDS=120
SAFWA_AI_MAX_OUTPUT_TOKENS=4096
# SAFWA_AI_MAX_RETRIES=3
# SAFWA_AI_SEND_TEMPERATURE=false
# SAFWA_AI_CACHE_BREAKPOINTS=true
# SAFWA_AI_REASONING_EFFORT=low

# OpenRouter instead of LM Studio. Leave SAFWA_AI_BASE_URL unset to take
# https://openrouter.ai/api/v1 automatically.
# SAFWA_AI_PROVIDER=openrouter
# SAFWA_AI_API_KEY=sk-or-v1-...
# SAFWA_AI_MODEL=openai/gpt-5.6-luna
# query_safwa result caps. A capped result is returned with a notice telling the model to
# narrow its query. Raise these only if the model has context window to spare.
SAFWA_AI_QUERY_ROW_LIMIT=50
SAFWA_AI_QUERY_CHAR_BUDGET=12000
SAFWA_TIMEZONE=Europe/Istanbul
SAFWA_LOG_LEVEL=INFO

# Voice input. `off` keeps the bot text-only. `groq`, `openai` and `local` all speak the
# same OpenAI-compatible /audio/transcriptions API, so `local` is any whisper server you
# run yourself (whisper.cpp server, faster-whisper-server, speaches) via SAFWA_ASR_BASE_URL.
SAFWA_ASR_PROVIDER=off
# SAFWA_ASR_API_KEY=gsk_...
# Leave the model and base URL unset to take the selected provider's defaults.
# SAFWA_ASR_MODEL=whisper-large-v3-turbo
# SAFWA_ASR_BASE_URL=
# Pin the language you speak. Empty detects one per message, which misfires on short notes.
SAFWA_ASR_LANGUAGE=ru
SAFWA_ASR_LOG_TIMING=true

# Safwa-QA live Telegram integration tests. Never reuse the production bot token or session path.
# Owner/API/provider values may be left empty to inherit the corresponding SAFWA_* value.
SAFWA_QA_TELEGRAM_BOT_TOKEN=
SAFWA_QA_TELEGRAM_BOT_USERNAME=
SAFWA_QA_TELEGRAM_OWNER_ID=
SAFWA_QA_TELEGRAM_API_ID=
SAFWA_QA_TELEGRAM_API_HASH=
SAFWA_QA_TELEGRAM_USER_SESSION_PATH=data/qa/telegram-user
SAFWA_QA_AI_BASE_URL=
SAFWA_QA_AI_API_KEY=
SAFWA_QA_AI_MODEL=
SAFWA_QA_LIVE_TIMEOUT_SECONDS=60
SAFWA_QA_KEEP_MESSAGES=false
SAFWA_QA_LOG_LEVEL=WARNING
