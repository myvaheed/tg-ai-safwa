SAFWA_TELEGRAM_BOT_TOKEN=
# Bot username without @; used to build t.me deep links for all supported item citations.
SAFWA_TELEGRAM_BOT_USERNAME=
SAFWA_TELEGRAM_OWNER_ID=
SAFWA_DATABASE_URL=sqlite:///data/safwa.db
SAFWA_DATA_DIR=data
# local (default) or openrouter: a row of PRESETS in
# src/llm_gateway/presets.py. The row supplies the base URL, retry budget, whether temperature
# is sent, and whether cache breakpoints are marked; every SAFWA_AI_* value below overrides it
# when set. docs/LLM_GATEWAY.md lists the models known to work on each.
# local is any server on this machine that speaks the OpenAI API: LM Studio at :1234, or
# Ollama at http://localhost:11434/v1 (with OLLAMA_CONTEXT_LENGTH=32768 set for its server),
# llama.cpp's llama-server at http://localhost:8080/v1, vLLM at http://localhost:8000/v1.
SAFWA_AI_PROVIDER=local
SAFWA_AI_BASE_URL=http://localhost:1234/v1
SAFWA_AI_API_KEY=lm-studio
SAFWA_AI_MODEL=local-model
SAFWA_AI_TIMEOUT_SECONDS=120
SAFWA_AI_MAX_OUTPUT_TOKENS=4096
# SAFWA_AI_MAX_RETRIES=3
# SAFWA_AI_SEND_TEMPERATURE=false
# SAFWA_AI_CACHE_BREAKPOINTS=true
# SAFWA_AI_REASONING_EFFORT=low
# A model that refuses a forced tool call — several do while they reason — needs this off.
# SAFWA_AI_TOOL_CHOICE_REQUIRED=false

# Another endpoint. Leave SAFWA_AI_BASE_URL unset to take the row's.
# OpenRouter, for every hosted model: GPT, Claude, Gemini, Grok, DeepSeek, Qwen, GLM.
# SAFWA_AI_PROVIDER=openrouter
# SAFWA_AI_API_KEY=sk-or-v1-...
# SAFWA_AI_MODEL=openai/gpt-5.6-luna
# query_safwa result caps. A capped result is returned with a notice telling the model to
# narrow its query. Raise these only if the model has context window to spare.
SAFWA_AI_QUERY_ROW_LIMIT=50
SAFWA_AI_QUERY_CHAR_BUDGET=12000
SAFWA_TIMEZONE=Europe/Istanbul
SAFWA_LOG_LEVEL=INFO

# Voice input. off | groq | openai | local | faster_whisper.
# groq/openai/local call /audio/transcriptions; `local` is your own whisper server.
# faster_whisper decodes here: uv sync --extra asr-local, weights from Hugging Face on
# first start (large-v3-turbo ~1.6 GB, small ~500 MB).
SAFWA_ASR_PROVIDER=off
# groq/openai only.
# SAFWA_ASR_API_KEY=
# Unset takes the provider default. 
# Names differ: 
# groq: whisper-large-v3-turbo,
# faster_whisper: large-v3-turbo or small, 
# local: whatever that server accepts.
# SAFWA_ASR_MODEL=
# local only.
# SAFWA_ASR_BASE_URL=
# Pin your language. Empty detects one per message, which misfires on short notes.
SAFWA_ASR_LANGUAGE=ru
# faster_whisper only. auto tries CUDA, then CPU. Compute type: int8 on CPU, float16 on CUDA.
SAFWA_ASR_DEVICE=auto
# SAFWA_ASR_COMPUTE_TYPE=
SAFWA_ASR_LOG_TIMING=true

# Safwa-QA live Telegram integration tests. Never reuse the production bot token.
# The API values are the owner-side Telethon session's own: create them at my.telegram.org and
# authorize once with: uv run safwa-qa-auth
# Owner/provider values may be left empty to inherit the corresponding SAFWA_* value.
SAFWA_QA_TELEGRAM_BOT_TOKEN=
SAFWA_QA_TELEGRAM_BOT_USERNAME=
SAFWA_QA_TELEGRAM_OWNER_ID=
SAFWA_QA_TELEGRAM_API_ID=
SAFWA_QA_TELEGRAM_API_HASH=
SAFWA_QA_TELEGRAM_USER_SESSION_PATH=data/qa/telegram-user
SAFWA_QA_AI_BASE_URL=
SAFWA_QA_AI_API_KEY=
SAFWA_QA_AI_MODEL=
SAFWA_QA_LIVE_TIMEOUT_SECONDS=60
SAFWA_QA_KEEP_MESSAGES=false
SAFWA_QA_LOG_LEVEL=WARNING
